+vpux::TileInfo vpux::VPU::TileXorAccOp::getMainOutputTile(mlir::OpResult, const vpux::TileInfo& secondaryOutputTile,
+                                                          vpux::Logger) {
+    TileInfo accTile(secondaryOutputTile.shape.size());
+    const auto numPartials = getNumPartials();
+    accTile.shape = Shape{1, 1, secondaryOutputTile.shape[Dims4D::Act::H] * frontend::tileXorRows(),
+                          secondaryOutputTile.shape[Dims4D::Act::W] / numPartials * TILE_COLS};
+    accTile.offsets = Shape{0, 0, secondaryOutputTile.offsets[Dims4D::Act::H] * frontend::tileXorRows(),
+                            secondaryOutputTile.offsets[Dims4D::Act::W] / numPartials * TILE_COLS};
+    accTile.axis = secondaryOutputTile.axis;
+    accTile.isCompletedTile = secondaryOutputTile.isCompletedTile;
+    return accTile;
+}
