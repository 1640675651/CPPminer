+using namespace vpux;
+
+namespace {
+
+// The tile words are laid out [1, 1, H/R, G * W/16] (R = frontend::tileXorRows(), partial-major within a tile
+// row), so that a row split over clusters leaves every cluster's share contiguous in memory and its copy to DDR is one 2D DMA.
+vpux::NDTypeInterface getXorType(vpux::NDTypeInterface accType, int64_t numPartials) {
+    const auto shape = accType.getShape();
+    const Shape xorShape{1, 1, shape[Dims4D::Act::H] / frontend::tileXorRows(),
+                         numPartials * (shape[Dims4D::Act::W] / VPU::TileXorAccOp::TILE_COLS)};
+    return accType.changeShape(xorShape);
+}
+
+// Output tile of the xor result that corresponds to a tile of the accumulator.
+TileInfo getXorTile(const TileInfo& accTile, int64_t numPartials) {
+    TileInfo xorTile(accTile.shape.size());
+    xorTile.shape = Shape{1, 1, accTile.shape[Dims4D::Act::H] / frontend::tileXorRows(),
+                          numPartials * (accTile.shape[Dims4D::Act::W] / VPU::TileXorAccOp::TILE_COLS)};
+    xorTile.offsets = Shape{0, 0, accTile.offsets[Dims4D::Act::H] / frontend::tileXorRows(),
+                            numPartials * (accTile.offsets[Dims4D::Act::W] / VPU::TileXorAccOp::TILE_COLS)};
+    xorTile.axis = accTile.axis;
+    xorTile.isCompletedTile = accTile.isCompletedTile;
+    return xorTile;
+}
+
+}  // namespace
