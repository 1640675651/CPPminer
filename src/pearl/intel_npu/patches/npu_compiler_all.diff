+// VPUNN has no SI32 SHAVE models. The experimental TileXorAcc kernel costs about 0.63 SHAVE cycles per input
+// element in a loaded graph (measured on NPU37XX: 39 us for 9 x 256 x 64 elements on 2 SHAVEs, 17 us for 4 x 256
+// x 64); split over the kernel runs that execute in parallel on the ACT SHAVEs. Other SI32 kernels keep cost 1.
+// The experimental TileJackpot kernel hashes 4 tiles per vector BLAKE3 compression: about TILE_JACKPOT_CYCLES_PER_TILE
+// per tile (one tile per 32 milestone words of its tile-word inputs).
+constexpr int64_t TILE_JACKPOT_CYCLES_PER_TILE = 400;
+constexpr int64_t TILE_JACKPOT_WORDS_PER_TILE = 32;
+
+size_t estimateI32SwKernelCost(VPUIP::SwKernelOp swKernelOp) {
+    const auto kernelName = swKernelOp.getKernelFunction().getLeafReference().str();
+    const bool jackpot = llvm::StringRef(kernelName).contains("TileJackpot");
+    if (!jackpot && !llvm::StringRef(kernelName).contains("TileXorAcc")) {
+        return 1;
+    }
+    int64_t elems = 0;
+    for (auto input : swKernelOp.getInputs()) {
+        elems += mlir::cast<vpux::NDTypeInterface>(input.getType()).getShape().totalSize();
+    }
+    const auto runs = std::max<int64_t>(1, std::distance(swKernelOp.getBody().getOps<VPUIP::SwKernelRun>().begin(),
+                                                         swKernelOp.getBody().getOps<VPUIP::SwKernelRun>().end()));
+    const auto cycles = jackpot ? elems / TILE_JACKPOT_WORDS_PER_TILE * TILE_JACKPOT_CYCLES_PER_TILE : elems * 5 / 8;
+    return static_cast<size_t>(std::max<int64_t>(1, cycles / runs));
+}
