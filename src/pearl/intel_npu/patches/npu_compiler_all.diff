@@ -0,0 +1,96 @@
+//
+// Copyright (C) 2026 Intel Corporation
+// SPDX-License-Identifier: Apache-2.0
+//
+
+#pragma once
+
+#include <openvino/core/attribute_visitor.hpp>
+#include <openvino/op/op.hpp>
+
+#include <cstdlib>
+#include <cstring>
+
+namespace vpux::frontend {
+
+/// Rows of a TileXorAcc XOR tile: 8, or 16 with NPU_EXPERIMENTAL_TILE_XOR_ROWS=16. The kernel takes the tile
+/// height from its tensors (accumulator rows / tile-word rows), so only the shapes depend on this.
+inline int64_t tileXorRows() {
+    const char* rows = std::getenv("NPU_EXPERIMENTAL_TILE_XOR_ROWS");
+    return rows != nullptr && std::strcmp(rows, "16") == 0 ? 16 : 8;
+}
+
+/// \brief Experimental running int32 accumulation with a per-tile XOR reduction.
+///
+/// Inputs are int32 tensors of identical shape [1, 1, H, W]. With has_acc = true, input 0 is a running
+/// accumulator and inputs 1..G are partial sums; otherwise inputs 0..G-1 are partial sums and the accumulator
+/// starts at zero. For each partial sum g (in order) the accumulator is updated (acc += partial_g) and every
+/// R x 16 tile of it (R = tileXorRows()) is reduced by XOR into xor_output[0, 0, H/R, G * W/16].
+/// acc_output is the final accumulator.
+///
+/// With dep_acc = true (and has_acc), input 0 is only a scheduling dependency: its values are ignored and the
+/// accumulator starts at zero. This lets a graph order independent accumulator chains.
+/// With dep_acc = true and has_acc = false, every input is already a cumulative sum: each is only XOR-reduced
+/// per tile, nothing is accumulated and acc_output is left unwritten (kernel acc_mode 3).
+///
+/// The op is serialized as type "TileXorAcc", version "extension", which is what an openvino.Op subclass
+/// named TileXorAcc produces on the Python side.
+class TileXorAcc : public ov::op::Op {
+public:
+    OPENVINO_OP("TileXorAcc", "extension", ov::op::Op);
+
+    static constexpr int64_t TILE_COLS = 16;
+
+    TileXorAcc() = default;
+
+    TileXorAcc(const ov::OutputVector& inputs, bool hasAcc, bool depAcc = false)
+            : ov::op::Op(inputs), _hasAcc(hasAcc), _depAcc(depAcc) {
+        constructor_validate_and_infer_types();
+    }
+
+    void validate_and_infer_types() override {
+        const auto numPartials = static_cast<int64_t>(get_input_size()) - (_hasAcc ? 1 : 0);
+        NODE_VALIDATION_CHECK(this, numPartials >= 1, "TileXorAcc needs at least one partial sum");
+        const auto& shape = get_input_partial_shape(0);
+        NODE_VALIDATION_CHECK(this, shape.is_static() && shape.rank().get_length() == 4,
+                              "TileXorAcc expects static rank-4 inputs");
+        const auto dims = shape.to_shape();
+        const auto tileRows = tileXorRows();
+        NODE_VALIDATION_CHECK(this, dims[0] == 1 && dims[1] == 1 && dims[2] % tileRows == 0 && dims[3] % TILE_COLS == 0,
+                              "TileXorAcc expects [1, 1, R*a, 16*b] inputs (R = tile rows)");
+        for (size_t i = 0; i < get_input_size(); ++i) {
+            NODE_VALIDATION_CHECK(this, get_input_element_type(i) == ov::element::i32,
+                                  "TileXorAcc inputs must be i32");
+            NODE_VALIDATION_CHECK(this, get_input_partial_shape(i) == shape, "TileXorAcc inputs must match");
+        }
+        set_output_type(0, ov::element::i32, shape);
+        // Tile words: [1, 1, H/R, G * W/16], partial-major within a tile row.
+        set_output_type(1, ov::element::i32,
+                        ov::PartialShape{1, 1, static_cast<int64_t>(dims[2]) / tileRows,
+                                         numPartials * (static_cast<int64_t>(dims[3]) / TILE_COLS)});
+    }
+
+    std::shared_ptr<ov::Node> clone_with_new_inputs(const ov::OutputVector& newArgs) const override {
+        return std::make_shared<TileXorAcc>(newArgs, _hasAcc, _depAcc);
+    }
+
+    bool visit_attributes(ov::AttributeVisitor& visitor) override {
+        visitor.on_attribute("has_acc", _hasAcc);
+        visitor.on_attribute("dep_acc", _depAcc);
+        return true;
+    }
+
+    bool hasAcc() const {
+        return _hasAcc;
+    }
+
+    bool depAcc() const {
+        return _depAcc;
+    }
+
+private:
+    bool _hasAcc = false;
+    bool _depAcc = false;
+};
+
+}  // namespace vpux::frontend
