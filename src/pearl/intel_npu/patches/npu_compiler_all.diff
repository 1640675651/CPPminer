+void vpux::VPU::TileJackpotOp::build(::mlir::OpBuilder& odsBuilder, ::mlir::OperationState& odsState,
+                                     ::mlir::ValueRange inputs, ::mlir::IntegerAttr chains) {
+    build(odsBuilder, odsState, inputs, chains, nullptr);
+}
+
+mlir::LogicalResult vpux::VPU::TileJackpotOp::inferReturnTypes(mlir::MLIRContext* ctx,
+                                                               std::optional<mlir::Location> optLoc,
+                                                               mlir::ValueRange operands, mlir::DictionaryAttr attrs,
+                                                               mlir::OpaqueProperties prop,
+                                                               mlir::RegionRange /*regions*/,
+                                                               mlir::SmallVectorImpl<mlir::Type>& inferredReturnTypes) {
+    const auto loc = optLoc.value_or(mlir::UnknownLoc::get(ctx));
+
+    VPU::TileJackpotOpAdaptor op(operands, attrs, prop);
+    if (mlir::failed(op.verify(loc))) {
+        return mlir::failure();
+    }
+
+    auto inType = mlir::cast<vpux::NDTypeInterface>(op.getInputs().front().getType());
+    if (auto distributed = mlir::dyn_cast<VPU::DistributedTensorType>(inType)) {
+        inType = mlir::cast<vpux::NDTypeInterface>(distributed.getCompactType());
+    }
+    const Shape outShape{1, 1, inType.getShape()[Dims4D::Act::H], 1};
+    inferredReturnTypes.push_back(inType.changeShape(outShape));
+    return mlir::success();
+}
+
+//
+// TilingBuilderOpInterface
+//
+
+// Every input is split by tile rows like the output; the params and tile-word columns stay whole.
+vpux::InputTiling vpux::VPU::TileJackpotOp::backInferTileInfo(const vpux::TileInfo& outputTile, vpux::Logger) {
+    SmallVector<TileInfo> tiles;
+    for (auto input : getInputs()) {
+        TileInfo tile(getShape(input));
+        tile.shape[Dims4D::Act::H] = outputTile.shape[Dims4D::Act::H];
+        tile.offsets[Dims4D::Act::H] = outputTile.offsets[Dims4D::Act::H];
+        tile.axis[Dims4D::Act::H] = outputTile.axis[Dims4D::Act::H];
+        tiles.push_back(tile);
+    }
+    return TilingInfo(tiles);
+}
+
+void vpux::VPU::TileJackpotOp::adjustAttrs(const TilingInfo&, const TileInfo&) {
+}
+
+mlir::FailureOr<OutputTiling> vpux::VPU::TileJackpotOp::getTilingStrategy(TilingMode tilingMode, Logger log) {
+    // Split tile rows only.
+    auto tilingInfo = mlir::cast<VPU::TilingInfoOpInterface>(getOperation());
+    const auto outputShape = getShape(getOutput());
+    const auto rows = outputShape[Dims4D::Act::H];
+    for (int64_t numTiles = 1; numTiles <= rows; ++numTiles) {
+        if (rows % numTiles != 0) {
+            continue;
+        }
+        OutputTiling tiles;
+        for (int64_t i = 0; i < numTiles; ++i) {
+            TileInfo tile(outputShape);
+            tile.shape[Dims4D::Act::H] = rows / numTiles;
+            tile.offsets[Dims4D::Act::H] = i * (rows / numTiles);
+            tile.axis[Dims4D::Act::H] = numTiles;
+            tile.isCompletedTile = true;
+            tiles.push_back(tile);
+        }
+        if (tilingInfo.isSupportedTiling(tiles, tilingMode, log)) {
+            log.trace("TileJackpot tiling: {0} row tiles", numTiles);
+            return tiles;
+        }
+    }
+    return mlir::failure();
+}
+
+//
+// ClusteredOpInterface
+//
+
+bool vpux::VPU::TileJackpotOp::checkStrategyCompatibility(VPU::MultiClusterStrategy strategy, size_t numTiles) {
+    if (strategy == VPU::MultiClusterStrategy::Clustering) {
+        return true;
+    }
+    if (strategy == VPU::MultiClusterStrategy::SplitOverHeight) {
+        // Every cluster gets the same number of tile rows, the same split as the TileXorAcc ops feeding it.
+        const auto rows = getShape(getOutput())[Dims4D::Act::H];
+        return numTiles > 1 && rows % static_cast<int64_t>(numTiles) == 0;
+    }
+    return false;
+}
+
+vpux::VPU::DistributionInfo vpux::VPU::TileJackpotOp::getExplicitDistributionInfoAttr(
+        vpux::ShapeRef shape, vpux::VPU::DistributionMode distributionMode, ArrayRef<int64_t> numTiles,
+        const int64_t numClusters, ArrayRef<int64_t> alignment, const bool uniformDistributedSegments,
+        const vpux::VPU::OverlapDistributionParams& overlapParams,
+        const std::optional<ArrayRef<int64_t>> /* memoryNumTiles */) {
+    return VPU::getSWExplicitDistributionInfo(mlir::cast<VPU::SWOpInterface>(getOperation()), shape,
+                                              distributionMode, numTiles, numClusters, alignment,
+                                              uniformDistributedSegments, overlapParams);
+}
+
+//
+// SWOpInterface
+//
+
+bool vpux::VPU::TileJackpotOp::fitIntoCMX(llvm::ArrayRef<vpux::NDTypeInterface> buffers, Byte reservedMem) {
+    SmallVector<Byte> buffersSize;
+    std::transform(buffers.begin(), buffers.end(), std::back_inserter(buffersSize), [](const auto buffer) {
+        return buffer.getTotalAllocSize();
+    });
+
+    auto totalAvailableCMXSize = reservedMem.count() == 0 ? getTotalCMXSize(getOperation()).count()
+                                                          : getTotalCMXFragmentationAwareSize(getOperation()).count();
+
+    return vpux::VPU::calculateAlignedBuffersMemoryRequirement(config::getArch(getOperation()), buffersSize).count() +
+                   reservedMem.count() <=
+           totalAvailableCMXSize;
+}
+
+bool vpux::VPU::TileJackpotOp::fitIntoCMX(llvm::ArrayRef<vpux::NDTypeInterface> buffers) {
+    return fitIntoCMX(buffers, Byte(0));
+}
+
+bool vpux::VPU::TileJackpotOp::supportCycleCostCalculation() {
+    return false;
+}
