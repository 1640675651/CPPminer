+//
+// RunI32AccumulationOnDPUPass
+//
+// Rewrites
+//     IE.Convolution(quant input, quant filter) -> f16 -> IE.Convert -> si32
+// into
+//     IE.Convolution(quant input, quant filter) -> !quant.uniform<i32:f16, 1.0> -> IE.QuantizeCast -> si32
+// when the combined requantization scale is exactly 1, so the DPU writes its int32 accumulator unchanged.
+//
+
+class RunI32AccumulationOnDPUPass final :
+        public mlir::PassWrapper<RunI32AccumulationOnDPUPass, mlir::OperationPass<mlir::func::FuncOp>> {
+public:
+    MLIR_DEFINE_EXPLICIT_INTERNAL_INLINE_TYPE_ID(RunI32AccumulationOnDPUPass)
+
+    explicit RunI32AccumulationOnDPUPass(Logger log): _log(log) {
+        _log.setName("run-i32-accumulation-on-dpu");
+    }
+
+    llvm::StringRef getArgument() const final {
+        return "run-i32-accumulation-on-dpu";
+    }
+
+    llvm::StringRef getDescription() const final {
+        return "Let DPU convolutions with unit requantization scale write int32 accumulators directly";
+    }
+
+    void runOnOperation() final;
+
+private:
+    bool isEligible(IE::ConvolutionOp conv) const;
+
+    Logger _log;
+};
+
+bool hasUnitScales(mlir::Type elemType) {
+    const auto scales = extractScalesAndZeroPoints(elemType).first;
+    return llvm::all_of(scales, [](double scale) {
+        return scale == 1.0;
+    });
+}
+
+bool RunI32AccumulationOnDPUPass::isEligible(IE::ConvolutionOp conv) const {
+    const auto nestedLog = _log.nest();
+    const auto inElemType = mlir::cast<NDTypeInterface>(conv.getInput().getType()).getElementType();
+    const auto filterElemType = mlir::cast<NDTypeInterface>(conv.getFilter().getType()).getElementType();
+
+    if (!mlir::isa<mlir::quant::UniformQuantizedType>(inElemType) ||
+        !mlir::isa<mlir::quant::UniformQuantizedType, mlir::quant::UniformQuantizedPerAxisType>(filterElemType)) {
+        nestedLog.trace("Input or filter is not uniformly quantized: {0}, {1}", inElemType, filterElemType);
+        return false;
+    }
+    if (!hasUnitScales(inElemType) || !hasUnitScales(filterElemType)) {
+        nestedLog.trace("Input or filter quantization scale is not exactly 1");
+        return false;
+    }
+    if (conv.getBias() != nullptr || conv.getScale() != nullptr || conv.getZeroPoints() != nullptr) {
+        nestedLog.trace("Convolution has bias, scale or zero-point operands");
+        return false;
+    }
+    if (conv.getPostOpAttr() != nullptr || conv.getClampAttr() != nullptr) {
+        nestedLog.trace("Convolution has a post-op or clamp");
+        return false;
+    }
+    if (const auto staticScale = conv.getStaticScaleAttr()) {
+        if (staticScale.getValueAsDouble() != 1.0) {
+            nestedLog.trace("Convolution has non-unit static scale");
+            return false;
+        }
+    }
+    if (mlir::failed(VPU::NCEInvariant::isSupported(conv.getOperation()))) {
+        nestedLog.trace("Convolution is not supported on DPU");
+        return false;
+    }
+    return true;
+}
+
+void RunI32AccumulationOnDPUPass::runOnOperation() {
+    const char* enabled = std::getenv("NPU_EXPERIMENTAL_I32_DPU_OUTPUT");
+    if (enabled == nullptr || std::string(enabled) != "1") {
+        return;
+    }
+
+    auto func = getOperation();
+    auto* ctx = &getContext();
+    struct Candidate {
+        IE::ConvertOp convert;
+        IE::ConvolutionOp conv;
+        SmallVector<mlir::Operation*> viewOps;
+    };
+    SmallVector<Candidate> candidates;
+
+    func.walk([&](IE::ConvertOp convert) {
+        _log.debug("Got '{0}' at '{1}'", convert->getName(), convert->getLoc());
+        const auto inElemType = mlir::cast<NDTypeInterface>(convert.getInput().getType()).getElementType();
+        const auto outElemType = mlir::cast<NDTypeInterface>(convert.getOutput().getType()).getElementType();
+        if (!inElemType.isF16() || !outElemType.isSignedInteger(32)) {
+            _log.nest().trace("Not an F16 -> SI32 Convert");
+            return;
+        }
+
+        // MatMul lowering leaves element-type-preserving reshapes between the convolution and the Convert.
+        SmallVector<mlir::Operation*> viewOps;
+        auto producer = convert.getInput().getDefiningOp();
+        while (producer != nullptr && producer->hasOneUse() &&
+               mlir::isa<IE::AffineReshapeOp, IE::ReshapeOp, IE::ShapeCastOp, IE::PermuteCastOp>(producer)) {
+            viewOps.push_back(producer);
+            producer = producer->getOperand(0).getDefiningOp();
+        }
+        auto conv = mlir::dyn_cast_or_null<IE::ConvolutionOp>(producer);
+        if (conv == nullptr || !conv->hasOneUse()) {
+            _log.nest().trace("Producer is not a single-use IE.Convolution");
+            return;
+        }
+        if (isEligible(conv)) {
+            candidates.push_back({convert, conv, std::move(viewOps)});
+        }
+    });
+
+    for (auto& [convert, conv, viewOps] : candidates) {
+        _log.debug("Convolution at '{0}' will output int32 accumulators", conv->getLoc());
+        const auto convOutType = mlir::cast<NDTypeInterface>(conv.getOutput().getType());
+        const auto i32QuantType = mlir::quant::UniformQuantizedType::get(
+                mlir::quant::QuantizationFlags::Signed, mlir::IntegerType::get(ctx, 32),
+                convOutType.getElementType(), /*scale=*/1.0, /*zeroPoint=*/0, std::numeric_limits<int32_t>::min(),
+                std::numeric_limits<int32_t>::max());
+        conv.getOutput().setType(mlir::cast<mlir::RankedTensorType>(convOutType.changeElemType(i32QuantType)));
+        for (auto* viewOp : viewOps) {
+            const auto viewType = mlir::cast<NDTypeInterface>(viewOp->getResult(0).getType());
+            viewOp->getResult(0).setType(mlir::cast<mlir::RankedTensorType>(viewType.changeElemType(i32QuantType)));
+        }
+
+        mlir::OpBuilder builder(convert);
+        const auto dstElemType = mlir::cast<NDTypeInterface>(convert.getOutput().getType()).getElementType();
+        auto cast = builder.create<IE::QuantizeCastOp>(convert->getLoc(), convert.getOutput().getType(),
+                                                       convert.getInput(), dstElemType);
+        convert.getOutput().replaceAllUsesWith(cast.getOutput());
+        convert->erase();
+    }
+}
+
+}  // namespace
+
+//
+// createRunI32AccumulationOnDPUPass
+//
+
+std::unique_ptr<mlir::Pass> vpux::IE::createRunI32AccumulationOnDPUPass(Logger log) {
+    return std::make_unique<RunI32AccumulationOnDPUPass>(log);
+}
