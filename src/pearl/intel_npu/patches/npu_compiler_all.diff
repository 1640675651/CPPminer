+
+mlir::LogicalResult vpux::IE::TileXorAccOp::verify() {
+    const auto numPartials = static_cast<int64_t>(getInputs().size()) - (getHasAcc() ? 1 : 0);
+    if (numPartials < 1) {
+        return errorAt(*this, "TileXorAcc needs at least one partial sum");
+    }
+    const auto shape = getShape(getInputs().front());
+    if (shape.size() != 4 || shape[Dims4D::Act::N] != 1 || shape[Dims4D::Act::C] != 1 ||
+        shape[Dims4D::Act::H] % frontend::tileXorRows() != 0 || shape[Dims4D::Act::W] % TILE_COLS != 0) {
+        return errorAt(*this, "TileXorAcc expects [1, 1, {0}*a, 16*b] inputs, got {1}", frontend::tileXorRows(),
+                       shape);
+    }
+    for (auto input : getInputs()) {
+        if (getShape(input) != shape) {
+            return errorAt(*this, "TileXorAcc inputs must have identical shapes");
+        }
+    }
+    return mlir::success();
+}
+
+mlir::LogicalResult vpux::IE::TileXorAccOp::inferReturnTypeComponents(
+        mlir::MLIRContext* ctx, std::optional<mlir::Location> optLoc, mlir::ValueShapeRange operands,
+        mlir::DictionaryAttr attrs, mlir::OpaqueProperties prop, mlir::RegionRange,
+        SmallVectorImpl<mlir::ShapedTypeComponents>& inferredReturnShapes) {
+    const auto loc = optLoc.value_or(mlir::UnknownLoc::get(ctx));
+
+    IE::TileXorAccOpAdaptor op(operands, attrs, prop);
+    if (mlir::failed(op.verify(loc))) {
+        return mlir::failure();
+    }
+
+    const auto inType = mlir::cast<mlir::ShapedType>(op.getInputs().front().getType());
+    const auto shape = inType.getShape();
+    const auto numPartials = static_cast<int64_t>(op.getInputs().size()) - (op.getHasAcc() ? 1 : 0);
+
+    inferredReturnShapes.emplace_back(shape, inType.getElementType());
+    const SmallVector<int64_t> xorShape{1, 1, shape[2] / frontend::tileXorRows(), numPartials * (shape[3] / TILE_COLS)};
+    inferredReturnShapes.emplace_back(xorShape, inType.getElementType());
+    return mlir::success();
+}
