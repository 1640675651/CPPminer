+//
+// ClusteredOpInterface
+//
+
+bool vpux::VPU::TileXorAccOp::checkStrategyCompatibility(VPU::MultiClusterStrategy strategy, size_t numTiles) {
+    if (strategy == VPU::MultiClusterStrategy::Clustering) {
+        return true;
+    }
+    if (strategy == VPU::MultiClusterStrategy::SplitOverHeight) {
+        // Every cluster must get whole tile-row groups of the same count.
+        const auto rows = getShape(getAccOutput())[Dims4D::Act::H];
+        return numTiles > 1 && rows % (frontend::tileXorRows() * static_cast<int64_t>(numTiles)) == 0;
+    }
+    return false;
+}
