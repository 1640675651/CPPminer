+//
+// Copyright (C) 2026 Intel Corporation
+// SPDX-License-Identifier: Apache-2.0
+//
+
+#pragma once
+
+#include <openvino/core/attribute_visitor.hpp>
+#include <openvino/op/op.hpp>
+
+namespace vpux::frontend {
+
+/// \brief Experimental keyed BLAKE3 jackpot over the tile words of TileXorAcc ops.
+///
+/// Input 0 (params) is int32 [1, 1, T, 16]: every row holds the 8 key words and then the 8 bound words (the rows
+/// repeat, so a row split leaves every part a copy). Inputs 1..n are TileXorAcc tile words, int32 [1, 1, T, G * C]
+/// each (T tile rows, G milestones of C tile columns, partial-major within a tile row), n = steps * chains in
+/// step-major order: input 1 + s * chains + c holds milestones s*G .. s*G+G-1 of chain c. Per tile the steps * G
+/// milestone words are folded into 16 words (word t = rotl(word t, 13) ^ milestone, t = milestone % 16), hashed by
+/// one keyed BLAKE3 compression and compared with the bound (most significant word 7 first, ties beat it).
+/// Output: int32 [1, 1, T, 1], per tile row 1 + the lowest tile column (c * C + j) that beats the bound, or 0.
+///
+/// The op is serialized as type "TileJackpot", version "extension".
+class TileJackpot : public ov::op::Op {
+public:
+    OPENVINO_OP("TileJackpot", "extension", ov::op::Op);
+
+    static constexpr int64_t PARAM_WORDS = 16;
+
+    TileJackpot() = default;
+
+    TileJackpot(const ov::OutputVector& inputs, int64_t chains): ov::op::Op(inputs), _chains(chains) {
+        constructor_validate_and_infer_types();
+    }
+
+    void validate_and_infer_types() override {
+        const auto numWords = static_cast<int64_t>(get_input_size()) - 1;
+        NODE_VALIDATION_CHECK(this, numWords >= 1 && _chains >= 1 && numWords % _chains == 0,
+                              "TileJackpot needs params and steps * chains tile-word inputs");
+        const auto& params = get_input_partial_shape(0);
+        const auto& words = get_input_partial_shape(1);
+        NODE_VALIDATION_CHECK(this, params.is_static() && words.is_static() && params.rank().get_length() == 4 &&
+                                            words.rank().get_length() == 4,
+                              "TileJackpot expects static rank-4 inputs");
+        const auto p = params.to_shape();
+        const auto w = words.to_shape();
+        NODE_VALIDATION_CHECK(this, p[0] == 1 && p[1] == 1 && p[3] == PARAM_WORDS && w[0] == 1 && w[1] == 1 &&
+                                            w[2] == p[2],
+                              "TileJackpot expects params [1, 1, T, 16] and tile words [1, 1, T, W]");
+        for (size_t i = 0; i < get_input_size(); ++i) {
+            NODE_VALIDATION_CHECK(this, get_input_element_type(i) == ov::element::i32,
+                                  "TileJackpot inputs must be i32");
+            if (i > 0) {
+                NODE_VALIDATION_CHECK(this, get_input_partial_shape(i) == words,
+                                      "TileJackpot tile-word inputs must match");
+            }
+        }
+        set_output_type(0, ov::element::i32, ov::PartialShape{1, 1, static_cast<int64_t>(p[2]), 1});
+    }
+
+    std::shared_ptr<ov::Node> clone_with_new_inputs(const ov::OutputVector& newArgs) const override {
+        return std::make_shared<TileJackpot>(newArgs, _chains);
+    }
+
+    bool visit_attributes(ov::AttributeVisitor& visitor) override {
+        visitor.on_attribute("chains", _chains);
+        return true;
+    }
+
+    int64_t chains() const {
+        return _chains;
+    }
+
+private:
+    int64_t _chains = 1;
+};
+
+}  // namespace vpux::frontend
