+mlir::LogicalResult vpux::IE::TileJackpotOp::verify() {
+    const auto numWords = static_cast<int64_t>(getInputs().size()) - 1;
+    const auto chains = static_cast<int64_t>(getChains());
+    if (numWords < 1 || chains < 1 || numWords % chains != 0) {
+        return errorAt(*this, "TileJackpot needs params and steps * chains tile-word inputs, got {0} inputs for {1} "
+                              "chains",
+                       getInputs().size(), chains);
+    }
+    const auto params = getShape(getInputs().front());
+    const auto words = getShape(getInputs()[1]);
+    if (params.size() != 4 || words.size() != 4 || params[Dims4D::Act::N] != 1 || params[Dims4D::Act::C] != 1 ||
+        params[Dims4D::Act::W] != frontend::TileJackpot::PARAM_WORDS || words[Dims4D::Act::N] != 1 ||
+        words[Dims4D::Act::C] != 1 || words[Dims4D::Act::H] != params[Dims4D::Act::H]) {
+        return errorAt(*this, "TileJackpot expects params [1, 1, T, 16] and tile words [1, 1, T, W], got {0}, {1}",
+                       params, words);
+    }
+    for (auto input : getInputs().drop_front()) {
+        if (getShape(input) != words) {
+            return errorAt(*this, "TileJackpot tile-word inputs must have identical shapes");
+        }
+    }
+    return mlir::success();
+}
+
+mlir::LogicalResult vpux::IE::TileJackpotOp::inferReturnTypeComponents(
+        mlir::MLIRContext* ctx, std::optional<mlir::Location> optLoc, mlir::ValueShapeRange operands,
+        mlir::DictionaryAttr attrs, mlir::OpaqueProperties prop, mlir::RegionRange,
+        SmallVectorImpl<mlir::ShapedTypeComponents>& inferredReturnShapes) {
+    const auto loc = optLoc.value_or(mlir::UnknownLoc::get(ctx));
+
+    IE::TileJackpotOpAdaptor op(operands, attrs, prop);
+    if (mlir::failed(op.verify(loc))) {
+        return mlir::failure();
+    }
+
+    const auto inType = mlir::cast<mlir::ShapedType>(op.getInputs().front().getType());
+    const auto shape = inType.getShape();
+    const SmallVector<int64_t> outShape{1, 1, shape[2], 1};
+    inferredReturnShapes.emplace_back(outShape, inType.getElementType());
+    return mlir::success();
+}
