+void ShaveBinaryResources::loadExperimentalOverrides() {
+    const char* dir = std::getenv("NPU_EXPERIMENTAL_SHAVE_KERNEL_DIR");
+    if (dir == nullptr || *dir == '\0') {
+        return;
+    }
+    std::error_code ec;
+    for (const auto& entry : std::filesystem::directory_iterator(dir, ec)) {
+        if (!entry.is_regular_file() || entry.path().extension() != ".elf") {
+            continue;
+        }
+        // Same key mangling as embed_shave_binaries.cmake: '.', ' ' and '-' become '_'.
+        auto symbolName = entry.path().filename().string();
+        std::replace_if(
+                symbolName.begin(), symbolName.end(),
+                [](char c) {
+                    return c == '.' || c == ' ' || c == '-';
+                },
+                '_');
+
+        std::ifstream file(entry.path(), std::ios::binary);
+        const std::vector<char> bytes((std::istreambuf_iterator<char>(file)), std::istreambuf_iterator<char>());
+        VPUX_THROW_WHEN(bytes.empty(), "Empty SHAVE kernel override '{0}'", entry.path().string());
+        auto storage = std::make_unique<uint8_t[]>(bytes.size());
+        memcpy(storage.get(), bytes.data(), bytes.size());
+        _shaveBinaryResourcesMap.erase(symbolName);
+        _shaveBinaryResourcesMap.insert(std::make_pair(symbolName, std::make_pair(storage.get(), bytes.size())));
+        _elfPermStorage.push_back(std::move(storage));
+    }
+}
