+// Measured on NPU37XX for 256 x 64 int32 outputs per cluster task: K = 128 takes 2.4 us, K = 512 3.8 us at
+// 1.6 GHz. The output unit bounds short-K tasks (about 0.23 cycles per int32 output) and the MAC array the rest
+// (about 1400 MACs per cycle), with the two overlapping.
+constexpr int64_t I32_OUTPUT_DPU_MACS_PER_CYCLE = 1400;
+constexpr int64_t I32_OUTPUT_ODU_CYCLES_PER_1000_OUTPUTS = 234;
+
+size_t estimateI32OutputDPUTaskCost(VPUIP::DPUTaskOp dpuTaskOp) {
+    auto nceOp = dpuTaskOp->getParentOfType<VPUIP::NCEClusterTaskOp>();
+    const auto outStart = parseIntArrayAttr<int64_t>(dpuTaskOp.getOutStart());
+    const auto outEnd = parseIntArrayAttr<int64_t>(dpuTaskOp.getOutEnd());
+    int64_t outElems = 1;
+    for (size_t i = 0; i < outStart.size(); ++i) {
+        outElems *= outEnd[i] - outStart[i] + 1;
+    }
+    int64_t kernelElems = 1;
+    if (auto kernelSizeAttr = nceOp.getKernelSizeAttr()) {
+        for (auto k : parseIntArrayAttr<int64_t>(kernelSizeAttr)) {
+            kernelElems *= k;
+        }
+    }
