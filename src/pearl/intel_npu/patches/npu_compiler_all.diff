+
+mlir::FailureOr<OutputTiling> vpux::VPU::TileXorAccOp::getTilingStrategy(TilingMode tilingMode, Logger log) {
+    // Split rows only, in whole tile-row groups, so every tile sees complete XOR tiles.
+    auto tilingInfo = mlir::cast<VPU::TilingInfoOpInterface>(getOperation());
+    const auto outputShape = getShape(getAccOutput());
+    const auto tileGroups = outputShape[Dims4D::Act::H] / frontend::tileXorRows();
+    for (int64_t numTiles = 1; numTiles <= tileGroups; ++numTiles) {
+        if (tileGroups % numTiles != 0) {
+            continue;
+        }
+        OutputTiling tiles;
+        const auto rows = outputShape[Dims4D::Act::H] / numTiles;
+        for (int64_t i = 0; i < numTiles; ++i) {
+            TileInfo tile(outputShape);
+            tile.shape[Dims4D::Act::H] = rows;
+            tile.offsets[Dims4D::Act::H] = i * rows;
+            tile.axis[Dims4D::Act::H] = numTiles;
+            tile.isCompletedTile = true;
+            tiles.push_back(tile);
+        }
+        if (tilingInfo.isSupportedTiling(tiles, tilingMode, log)) {
+            log.trace("TileXorAcc tiling: {0} row tiles", numTiles);
+            return tiles;
+        }
+    }
+    return mlir::failure();
+}
