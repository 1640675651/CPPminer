+//
+// CopyThroughViewChain
+//
+// Copy(CMX->DDR) -> view-like ops -> Copy(DDR->CMX)   ==>   view-like ops on the CMX source -> Copy(CMX->CMX)
+// Keeps an intermediate on-chip when its consumer reads it through strided views that cannot become a plain view.
+// Non-distributed buffers only; enabled by NPU_EXPERIMENTAL_COPY_THROUGH_VIEWS=1.
+//
+
+class CopyThroughViewChain final : public mlir::OpRewritePattern<VPUIP::CopyOp> {
+public:
+    CopyThroughViewChain(mlir::MLIRContext* ctx, mlir::PatternBenefit benefit, Logger log)
+            : mlir::OpRewritePattern<VPUIP::CopyOp>(ctx, benefit), log(log) {
+    }
+
+    mlir::LogicalResult matchAndRewrite(VPUIP::CopyOp copyOp, mlir::PatternRewriter& rewriter) const final {
+        if (vpux::VPUIP::hasDistributedOperand(copyOp) || !VPUIP::isCopyFromDDR(copyOp) ||
+            VPUIP::isCopyToDDR(copyOp)) {
+            return mlir::failure();
+        }
+
+        SmallVector<mlir::Operation*> viewChain;
+        mlir::Value source = copyOp.getInput();
+        while (auto* op = source.getDefiningOp()) {
+            if (!mlir::isa<VPUIP::SubViewOp, VPUIP::ShapeCastOp, VPUIP::QuantizeCastOp, VPUIP::GenericReshapeOp,
+                           VPUIP::PermuteCastOp>(op) ||
+                op->getNumOperands() != 1) {
+                break;
+            }
+            viewChain.push_back(op);
+            source = op->getOperand(0);
+        }
+        if (viewChain.empty()) {
+            return mlir::failure();
+        }
+
+        auto parentCopy = source.getDefiningOp<VPUIP::CopyOp>();
+        if (parentCopy == nullptr || vpux::VPUIP::hasDistributedOperand(parentCopy) ||
+            VPUIP::isCopyFromDDR(parentCopy) || !VPUIP::isCopyToDDR(parentCopy) ||
+            VPUIP::getRootAlloc<mlir::memref::AllocOp>(parentCopy.getOutputBuff()) == nullptr) {
+            return mlir::failure();
+        }
+        const auto cmxType = mlir::cast<vpux::NDTypeInterface>(parentCopy.getInput().getType());
+        const auto ddrType = mlir::cast<vpux::NDTypeInterface>(parentCopy.getOutput().getType());
+        if (cmxType.changeMemSpace(ddrType.getMemSpace()) != ddrType) {
+            return mlir::failure();
+        }
+
+        rewriter.setInsertionPoint(copyOp);
+        mlir::Value cmxView = parentCopy.getInput();
+        for (auto* viewOp : llvm::reverse(viewChain)) {
+            mlir::IRMapping mapping;
+            mapping.map(viewOp->getOperand(0), cmxView);
+            auto* clone = rewriter.clone(*viewOp, mapping);
+            const auto viewType = mlir::cast<vpux::NDTypeInterface>(clone->getResult(0).getType());
+            clone->getResult(0).setType(viewType.changeMemSpace(cmxType.getMemSpace()));
+            cmxView = clone->getResult(0);
+        }
+        rewriter.replaceOpWithNewOp<VPUIP::CopyOp>(copyOp, cmxView, copyOp.getOutputBuff());
+        log.trace("CopyThroughViewChain: replaced a DDR round trip through {0} view ops with a CMX copy",
+                  viewChain.size());
+        return mlir::success();
+    }
+
+private:
+    Logger log;
+};
