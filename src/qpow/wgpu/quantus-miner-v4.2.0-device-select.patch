+fn device_type_label(dt: wgpu::DeviceType) -> &'static str {
+    match dt {
+        wgpu::DeviceType::DiscreteGpu => "DiscreteGpu",
+        wgpu::DeviceType::IntegratedGpu => "IntegratedGpu",
+        wgpu::DeviceType::VirtualGpu => "VirtualGpu",
+        wgpu::DeviceType::Cpu => "Cpu",
+        _ => "Other",
+    }
+}
+
+/// One mining-usable adapter as shown by `--list-devices` / `list_mining_adapters`.
+/// `index` is the selection index accepted by `try_new_with_devices`.
+#[derive(Debug, Clone)]
+pub struct ListedAdapter {
+    pub index: usize,
+    pub name: String,
+    pub device_type: &'static str,
+    pub backend: String,
+}
+
+/// Enumerate adapters that would be considered for mining (same filter as init:
+/// drop CPU emulators, keep best backend only, discrete-first order).
+pub fn list_mining_adapters() -> Vec<ListedAdapter> {
+    let instance = wgpu::Instance::new(&wgpu::InstanceDescriptor {
+        backends: wgpu::Backends::PRIMARY,
+        ..Default::default()
+    });
+    let adapters = instance.enumerate_adapters(wgpu::Backends::PRIMARY);
+    let infos: Vec<wgpu::AdapterInfo> = adapters.iter().map(|a| a.get_info()).collect();
+    let selected = select_adapters(&infos);
+    selected
+        .into_iter()
+        .enumerate()
+        .map(|(i, raw)| {
+            let info = &infos[raw];
+            ListedAdapter {
+                index: i,
+                name: info.name.clone(),
+                device_type: device_type_label(info.device_type),
+                backend: format!("{:?}", info.backend),
+            }
+        })
+        .collect()
+}
